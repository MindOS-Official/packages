#!/usr/bin/env python3
# ==============================================================================
# MindOS Sunrise Official Package Manager (mindpkg)
# Native Package Format: .mind (Zstandard compressed container)
# Official Repository: https://github.com/MindOS-Official/packages
# ==============================================================================

import os
import sys
import json
import shutil
import hashlib
import subprocess
import urllib.request
import urllib.error
from pathlib import Path

VERSION = "1.0.0"
CONFIG_FILE = "/etc/mindpkg/mindpkg.conf"
REPOS_DIR = "/etc/mindpkg/repos.d"
DB_DIR = "/var/lib/mindpkg"
INSTALLED_DIR = f"{DB_DIR}/installed"
REPOS_CACHE = f"{DB_DIR}/repos"
CACHE_DIR = "/var/cache/mindpkg/pkg"

# ANSI Colors
COLOR_BANNER = "\033[1;33m"  # Sunrise Gold
COLOR_ACCENT = "\033[1;36m"  # Cyan
COLOR_GREEN = "\033[1;32m"
COLOR_RED = "\033[1;31m"
COLOR_BOLD = "\033[1m"
COLOR_RESET = "\033[0m"

DEFAULT_CONFIG = {
    "architecture": "x86_64",
    "cache_dir": CACHE_DIR,
    "repositories": [
        {
            "name": "official",
            "url": "https://raw.githubusercontent.com/MindOS-Official/packages/main",
            "enabled": True
        }
    ]
}


def print_banner():
    print(f"{COLOR_BANNER}🌅 MindOS Sunrise Package Manager (mindpkg v{VERSION}){COLOR_RESET}")
    print(f"{COLOR_ACCENT}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━{COLOR_RESET}")


def ensure_directories():
    for d in [DB_DIR, INSTALLED_DIR, REPOS_CACHE, CACHE_DIR, "/etc/mindpkg", REPOS_DIR]:
        Path(d).mkdir(parents=True, exist_ok=True)
    if not os.path.exists(CONFIG_FILE):
        with open(CONFIG_FILE, "w", encoding="utf-8") as f:
            json.dump(DEFAULT_CONFIG, f, indent=4)


def load_config():
    ensure_directories()
    try:
        with open(CONFIG_FILE, "r", encoding="utf-8") as f:
            return json.load(f)
    except Exception:
        return DEFAULT_CONFIG


def check_root():
    if os.geteuid() != 0:
        print(f"{COLOR_RED}Hata:{COLOR_RESET} Bu işlem için yönetici (root) yetkisi gereklidir.")
        print(f"Lütfen komutu {COLOR_BOLD}sudo mindpkg ...{COLOR_RESET} şeklinde çalıştırın.")
        sys.exit(1)


def calculate_sha256(filepath):
    h = hashlib.sha256()
    with open(filepath, "rb") as f:
        while chunk := f.read(8192):
            h.update(chunk)
    return h.hexdigest()


def run_system_triggers():
    triggers = [
        ["ldconfig"],
        ["update-desktop-database", "-q", "/usr/share/applications"],
        ["gtk-update-icon-cache", "-q", "-t", "-f", "/usr/share/icons/hicolor"],
        ["glib-compile-schemas", "/usr/share/glib-2.0/schemas"]
    ]
    for cmd in triggers:
        if shutil.which(cmd[0]):
            try:
                subprocess.run(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            except Exception:
                pass


def download_with_progress(url, dest_path):
    """İlerleme çubuğu ile uzak dosyayı güvenilir şekilde indirir"""
    if "raw.githubusercontent.com" in url and "/pkgs/" in url:
        url = url.replace("raw.githubusercontent.com", "media.githubusercontent.com/media")
    
    dest_path = Path(dest_path)
    dest_path.parent.mkdir(parents=True, exist_ok=True)
    
    if shutil.which("curl"):
        res = subprocess.run(["curl", "-sSL", "--fail", "-o", str(dest_path), url], check=False)
        if res.returncode == 0 and dest_path.exists() and dest_path.stat().st_size > 0:
            return
            
    req = urllib.request.Request(url, headers={"User-Agent": f"mindpkg/{VERSION} (MindOS Sunrise)"})
    with urllib.request.urlopen(req, timeout=30) as response, open(dest_path, "wb") as f:
        shutil.copyfileobj(response, f)

def update_repos():
    """Uzak MindOS depolarını günceller ve kendini otomatik günceller"""
    check_root()
    cfg = load_config()
    repos = cfg.get("repositories", [])
    print(f"{COLOR_GREEN}==>{COLOR_RESET} MindOS Sunrise depoları eşitleniyor...")
    for repo in repos:
        if not repo.get("enabled", True):
            continue
        name = repo["name"]
        url = repo["url"]
        index_url = f"{url}/packages.json"
        dest_file = Path(REPOS_CACHE) / f"{name}.json"
        print(f"  {COLOR_ACCENT}• {name}:{COLOR_RESET} {index_url}")
        try:
            download_with_progress(index_url, dest_file)
            try:
                with open(dest_file, "r", encoding="utf-8") as df:
                    c = df.read()
                if "raw.githubusercontent.com" in c:
                    c = c.replace("https://raw.githubusercontent.com/MindOS-Official/packages/main/pkgs/x86_64/", "https://media.githubusercontent.com/media/MindOS-Official/packages/main/pkgs/x86_64/")
                    with open(dest_file, "w", encoding="utf-8") as df:
                        df.write(c)
            except Exception:
                pass
            print(f"    {COLOR_GREEN}✓ Başarıyla güncellendi.{COLOR_RESET}")
        except Exception as e:
            print(f"    {COLOR_BANNER}⚠ Depo güncellenemedi: {e}{COLOR_RESET}")

    try:
        self_url = "https://raw.githubusercontent.com/MindOS-Official/packages/main/tools/mindpkg"
        req = urllib.request.Request(self_url, headers={"User-Agent": f"mindpkg/{VERSION}"})
        with urllib.request.urlopen(req, timeout=5) as resp:
            new_code = resp.read().decode("utf-8")
            if "#!/usr/bin/env python3" in new_code and "MindOS Package Manager" in new_code:
                current_path = Path("/usr/bin/mindpkg")
                if current_path.exists():
                    with open(current_path, "w", encoding="utf-8") as f:
                        f.write(new_code)
                    os.chmod(current_path, 0o755)
    except Exception:
        pass


def install_mind_file(file_path):
    """Yerel bir .mind dosyasını sisteme kurar"""
    check_root()
    file_path = Path(file_path).resolve()
    if not file_path.exists():
        print(f"{COLOR_RED}Hata:{COLOR_RESET} Dosya bulunamadı: {file_path}")
        sys.exit(1)

    import tempfile
    with tempfile.TemporaryDirectory() as tmpdir:
        try:
            subprocess.run(["tar", "--zstd", "-xf", str(file_path), "-C", tmpdir], check=True)
        except subprocess.CalledProcessError:
            print(f"{COLOR_RED}Hata:{COLOR_RESET} {file_path} geçerli bir MindOS paketi değil!")
            sys.exit(1)

        meta_file = Path(tmpdir) / "metadata.json"
        if not meta_file.exists():
            print(f"{COLOR_RED}Hata:{COLOR_RESET} Pakette metadata.json bulunamadı!")
            sys.exit(1)

        with open(meta_file, "r", encoding="utf-8") as f:
            meta = json.load(f)

        pkg_name = meta["name"]
        pkg_ver = meta.get("version", "1.0")

        print(f"{COLOR_GREEN}==>{COLOR_RESET} Kuruluyor: {COLOR_BOLD}{pkg_name} ({pkg_ver}){COLOR_RESET} ...")

        # pre_install hook
        pre_install = Path(tmpdir) / "pre_install.sh"
        if pre_install.exists():
            os.chmod(pre_install, 0o755)
            subprocess.run([str(pre_install)], check=False)

        # Dosyaları çıkart ve listele
        files_archive = Path(tmpdir) / "files.tar.zst"
        installed_files = []
        if files_archive.exists():
            tar_list = subprocess.check_output(["tar", "--zstd", "-tf", str(files_archive)], text=True)
            for line in tar_list.splitlines():
                clean_line = line.lstrip(".").lstrip("/")
                if clean_line:
                    installed_files.append("/" + clean_line)

            subprocess.run(["tar", "--zstd", "-xf", str(files_archive), "-C", "/"], check=True)

        # post_install hook
        post_install = Path(tmpdir) / "post_install.sh"
        if post_install.exists():
            os.chmod(post_install, 0o755)
            subprocess.run([str(post_install)], check=False)

        # Veritabanına kaydet
        meta["installed_files"] = installed_files
        pkg_record = Path(INSTALLED_DIR) / f"{pkg_name}.json"
        with open(pkg_record, "w", encoding="utf-8") as f:
            json.dump(meta, f, indent=4)

        run_system_triggers()
        print(f"{COLOR_GREEN}✓ Tamamlandı:{COLOR_RESET} {pkg_name} ({pkg_ver}) sisteme kuruldu.")


def install_from_repo_or_name(pkg_name):
    """Depolarda paket adını arar, indirir, SHA256 doğrular ve kurar"""
    check_root()
    # Önce depoları tara
    target_meta = None
    for r in Path(REPOS_CACHE).glob("*.json"):
        try:
            with open(r, "r", encoding="utf-8") as f:
                repo_data = json.load(f)
            for pkg in repo_data.get("packages", []):
                if pkg.get("name") == pkg_name:
                    target_meta = pkg
                    break
        except Exception:
            pass
        if target_meta:
            break

    if not target_meta:
        # Otomatik depoları güncelle ve tekrar ara
        print(f"{COLOR_BANNER}Paket yerel önbellekte bulunamadı, depolar güncelleniyor...{COLOR_RESET}")
        update_repos()
        for r in Path(REPOS_CACHE).glob("*.json"):
            try:
                with open(r, "r", encoding="utf-8") as f:
                    repo_data = json.load(f)
                for pkg in repo_data.get("packages", []):
                    if pkg.get("name") == pkg_name:
                        target_meta = pkg
                        break
            except Exception:
                pass
            if target_meta:
                break

    if not target_meta:
        print(f"{COLOR_RED}Hata:{COLOR_RESET} '{pkg_name}' resmi MindOS depolarında bulunamadı.")
        # Flatpak kontrolü
        if shutil.which("flatpak"):
            print(f"{COLOR_ACCENT}İpucu:{COLOR_RESET} Bu uygulama Flathub üzerinde olabilir. 'flatpak search {pkg_name}' ile arayabilirsiniz.")
        sys.exit(1)

    url = target_meta.get("url")
    filename = target_meta.get("filename", f"{pkg_name}.mind")
    expected_sha256 = target_meta.get("sha256")
    cached_file = Path(CACHE_DIR) / filename

    print(f"{COLOR_GREEN}==>{COLOR_RESET} İndiriliyor: {COLOR_BOLD}{pkg_name} {target_meta.get('version')}{COLOR_RESET} ...")
    print(f"  {COLOR_ACCENT}Kaynak:{COLOR_RESET} {url}")
    download_with_progress(url, cached_file)

    if expected_sha256:
        print(f"  {COLOR_ACCENT}Doğrulanıyor (SHA256)...{COLOR_RESET}")
        actual_sha256 = calculate_sha256(cached_file)
        if actual_sha256 != expected_sha256:
            print(f"{COLOR_RED}Hata:{COLOR_RESET} SHA256 doğrulama başarısız! Dosya bozulmuş olabilir.")
            cached_file.unlink(missing_ok=True)
            sys.exit(1)
        print(f"  {COLOR_GREEN}✓ İmza doğrulandı.{COLOR_RESET}")

    install_mind_file(cached_file)


def remove_package(pkg_name):
    """Sistemden kurulu bir paketi temiz bir şekilde kaldırır"""
    check_root()
    pkg_record = Path(INSTALLED_DIR) / f"{pkg_name}.json"
    if not pkg_record.exists():
        print(f"{COLOR_RED}Hata:{COLOR_RESET} '{pkg_name}' sistemde kurulu değil!")
        sys.exit(1)

    with open(pkg_record, "r", encoding="utf-8") as f:
        meta = json.load(f)

    print(f"{COLOR_RED}==>{COLOR_RESET} Kaldırılıyor: {COLOR_BOLD}{pkg_name} ({meta.get('version')}){COLOR_RESET} ...")

    files = meta.get("installed_files", [])
    for file_path in reversed(files):
        p = Path(file_path)
        try:
            if p.is_symlink() or p.is_file():
                p.unlink(missing_ok=True)
            elif p.is_dir():
                if not any(p.iterdir()):
                    p.rmdir()
        except Exception:
            pass

    pkg_record.unlink(missing_ok=True)
    run_system_triggers()
    print(f"{COLOR_GREEN}✓ Tamamlandı:{COLOR_RESET} {pkg_name} sistemden kaldırıldı.")


def list_installed():
    """Kurulu paketleri listeler"""
    records = list(Path(INSTALLED_DIR).glob("*.json"))
    if not records:
        print(f"{COLOR_ACCENT}Sistemde mindpkg ile kurulmuş paket bulunmuyor.{COLOR_RESET}")
        return

    print(f"{COLOR_BOLD}{'Paket Adı':<25} {'Sürüm':<15} {'Açıklama'}{COLOR_RESET}")
    print(f"{'-'*70}")
    for r in sorted(records):
        try:
            with open(r, "r", encoding="utf-8") as f:
                meta = json.load(f)
            name = meta.get("name", r.stem)
            ver = meta.get("version", "-")
            desc = meta.get("description", "-")
            print(f"{COLOR_GREEN}{name:<25}{COLOR_RESET} {ver:<15} {desc}")
        except Exception:
            pass


def info_package(pkg_name):
    """Paket hakkında detaylı bilgi gösterir"""
    pkg_record = Path(INSTALLED_DIR) / f"{pkg_name}.json"
    if pkg_record.exists():
        with open(pkg_record, "r", encoding="utf-8") as f:
            meta = json.load(f)
        print(f"{COLOR_BOLD}Paket Adı:{COLOR_RESET}     {meta.get('name')}")
        print(f"{COLOR_BOLD}Sürüm:{COLOR_RESET}         {meta.get('version')}")
        print(f"{COLOR_BOLD}Açıklama:{COLOR_RESET}      {meta.get('description')}")
        print(f"{COLOR_BOLD}Mimari:{COLOR_RESET}        {meta.get('architecture', 'all')}")
        print(f"{COLOR_BOLD}Durum:{COLOR_RESET}         {COLOR_GREEN}Kurulu{COLOR_RESET}")
        print(f"{COLOR_BOLD}Dosya Sayısı:{COLOR_RESET}  {len(meta.get('installed_files', []))}")
        return

    # Depolarda ara
    for r in Path(REPOS_CACHE).glob("*.json"):
        try:
            with open(r, "r", encoding="utf-8") as f:
                repo_data = json.load(f)
            for pkg in repo_data.get("packages", []):
                if pkg.get("name") == pkg_name:
                    print(f"{COLOR_BOLD}Paket Adı:{COLOR_RESET}     {pkg.get('name')}")
                    print(f"{COLOR_BOLD}Sürüm:{COLOR_RESET}         {pkg.get('version')}-{pkg.get('release', '1')}")
                    print(f"{COLOR_BOLD}Açıklama:{COLOR_RESET}      {pkg.get('description')}")
                    print(f"{COLOR_BOLD}Mimari:{COLOR_RESET}        {pkg.get('architecture', 'all')}")
                    print(f"{COLOR_BOLD}Durum:{COLOR_RESET}         {COLOR_ACCENT}Depoda Mevcut ({r.stem}){COLOR_RESET}")
                    print(f"{COLOR_BOLD}Paket Boyutu:{COLOR_RESET}  {pkg.get('size', 0):,} bayt")
                    print(f"{COLOR_BOLD}İndirme URL:{COLOR_RESET}   {pkg.get('url')}")
                    return
        except Exception:
            pass

    print(f"{COLOR_RED}Hata:{COLOR_RESET} '{pkg_name}' bulunamadı.")


def search_repos(query):
    """Depolarda ve yerel paketlerde arama yapar"""
    query = query.lower()
    print(f"{COLOR_ACCENT}==>{COLOR_RESET} Aranıyor: '{COLOR_BOLD}{query}{COLOR_RESET}' ...\n")
    found = False

    # Yerel kurulu olanlar
    for r in Path(INSTALLED_DIR).glob("*.json"):
        try:
            with open(r, "r", encoding="utf-8") as f:
                meta = json.load(f)
            name = meta.get("name", "")
            desc = meta.get("description", "")
            if query in name.lower() or query in desc.lower():
                print(f"  {COLOR_GREEN}{name}{COLOR_RESET} {meta.get('version')} [{COLOR_ACCENT}kurulu{COLOR_RESET}]")
                print(f"    {desc}\n")
                found = True
        except Exception:
            pass

    # Depolardaki paketler
    for r in Path(REPOS_CACHE).glob("*.json"):
        try:
            with open(r, "r", encoding="utf-8") as f:
                repo_data = json.load(f)
            for pkg in repo_data.get("packages", []):
                name = pkg.get("name", "")
                desc = pkg.get("description", "")
                if query in name.lower() or query in desc.lower():
                    print(f"  {COLOR_GREEN}{name}{COLOR_RESET} {pkg.get('version')} [{r.stem}]")
                    print(f"    {desc}\n")
                    found = True
        except Exception:
            pass

    if not found:
        print(f"'{query}' ile eşleşen bir paket bulunamadı.")


def build_package(source_dir, output_file=None):
    """Bir dizinden resmi .mind paketi inşa eder"""
    src_path = Path(source_dir).resolve()
    meta_file = src_path / "metadata.json"
    files_dir = src_path / "rootfs"

    if not meta_file.exists():
        print(f"{COLOR_RED}Hata:{COLOR_RESET} {meta_file} bulunamadı!")
        sys.exit(1)

    with open(meta_file, "r", encoding="utf-8") as f:
        meta = json.load(f)

    pkg_name = meta.get("name", "unnamed")
    pkg_ver = meta.get("version", "1.0.0")
    pkg_rel = meta.get("release", "1")
    pkg_arch = meta.get("architecture", "x86_64")

    if not output_file:
        output_file = f"{pkg_name}-{pkg_ver}-{pkg_rel}-{pkg_arch}.mind"

    print(f"{COLOR_GREEN}==>{COLOR_RESET} Paket derleniyor: {COLOR_BOLD}{output_file}{COLOR_RESET} ...")

    import tempfile
    with tempfile.TemporaryDirectory() as tmpdir:
        tmp_path = Path(tmpdir)
        shutil.copy2(meta_file, tmp_path / "metadata.json")

        for hook in ["pre_install.sh", "post_install.sh", "pre_remove.sh", "post_remove.sh"]:
            h_file = src_path / hook
            if h_file.exists():
                shutil.copy2(h_file, tmp_path / hook)

        files_archive = tmp_path / "files.tar.zst"
        if files_dir.exists():
            subprocess.run(["tar", "--zstd", "-cf", str(files_archive), "-C", str(files_dir), "."], check=True)
        else:
            subprocess.run(["tar", "--zstd", "-cf", str(files_archive), "--files-from", "/dev/null"], check=True)

        subprocess.run(["tar", "--zstd", "-cf", str(Path(output_file).resolve()), "-C", str(tmp_path), "."], check=True)

    print(f"{COLOR_GREEN}✓ BAŞARILI:{COLOR_RESET} {output_file} hazırlandı! ({os.path.getsize(output_file):,} bayt)")


def main():
    print_banner()
    ensure_directories()

    if len(sys.argv) < 2:
        print(f"{COLOR_BOLD}Kullanım:{COLOR_RESET} mindpkg <komut> [seçenekler] [argümanlar...]\n")
        print("Temel Komutlar:")
        print(f"  {COLOR_GREEN}install, add, i{COLOR_RESET} <paket | dosya.mind>     Paket kurar (Depodan veya yerel)")
        print(f"  {COLOR_GREEN}remove, rm, del{COLOR_RESET} <paket>                         Paket kaldırır")
        print(f"  {COLOR_GREEN}update, sync, up{COLOR_RESET}                              Depoları günceller")
        print(f"  {COLOR_GREEN}search, s{COLOR_RESET} <kelime>                              Paket arar")
        print(f"  {COLOR_GREEN}list, ls{COLOR_RESET}                                      Kurulu paketleri listeler")
        print(f"  {COLOR_GREEN}info, show{COLOR_RESET} <paket>                              Paket bilgisini gösterir")
        print(f"  {COLOR_GREEN}build{COLOR_RESET} <kaynak_dizini>                         .mind paketi derler")
        print(f"  {COLOR_GREEN}clean{COLOR_RESET}                                         Önbelleği temizler")
        sys.exit(0)

    cmd = sys.argv[1].lower()
    args = sys.argv[2:]

    if cmd in ["install", "add", "i"]:
        if not args:
            print(f"{COLOR_RED}Hata:{COLOR_RESET} Kurulacak paket adı belirtilmedi.")
            sys.exit(1)
        for target in args:
            if target.endswith(".mind") or os.path.exists(target):
                install_mind_file(target)
            else:
                install_from_repo_or_name(target)

    elif cmd in ["remove", "rm", "del", "uninstall"]:
        if not args:
            print(f"{COLOR_RED}Hata:{COLOR_RESET} Kaldırılacak paket adı belirtilmedi.")
            sys.exit(1)
        for pkg in args:
            remove_package(pkg)

    elif cmd in ["update", "sync", "up"]:
        update_repos()

    elif cmd in ["search", "s", "find"]:
        if not args:
            print(f"{COLOR_RED}Hata:{COLOR_RESET} Aranacak kelime belirtilmedi.")
            sys.exit(1)
        search_repos(" ".join(args))

    elif cmd in ["list", "ls"]:
        list_installed()

    elif cmd in ["info", "show"]:
        if not args:
            print(f"{COLOR_RED}Hata:{COLOR_RESET} Paket adı belirtilmedi.")
            sys.exit(1)
        info_package(args[0])

    elif cmd in ["build", "pkg-build"]:
        src = args[0] if args else "."
        out = args[1] if len(args) > 1 else None
        build_package(src, out)

    elif cmd in ["clean", "gc"]:
        check_root()
        shutil.rmtree(CACHE_DIR, ignore_errors=True)
        ensure_directories()
        print(f"{COLOR_GREEN}✓ Önbellek temizlendi.{COLOR_RESET}")

    else:
        print(f"{COLOR_RED}Bilinmeyen komut:{COLOR_RESET} {cmd}")
        print("Yardım için: 'mindpkg' yazın.")


if __name__ == "__main__":
    main()

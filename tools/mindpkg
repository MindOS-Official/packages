def ensure_directories():
    for d in [DB_DIR, INSTALLED_DIR, REPOS_CACHE, CACHE_DIR, "/etc/mindpkg", REPOS_DIR]:
        Path(d).mkdir(parents=True, exist_ok=True)
    if not os.path.exists(CONFIG_FILE):
        with open(CONFIG_FILE, "w", encoding="utf-8") as f:
            json.dump(DEFAULT_CONFIG, f, indent=4)


def load_config():
    ensure_directories()
    try:
        with open(CONFIG_FILE, "r", encoding="utf-8") as f:
            return json.load(f)
    except Exception:
        return DEFAULT_CONFIG


def check_root():
    if os.geteuid() != 0:
        print(f"{COLOR_RED}Hata:{COLOR_RESET} Bu işlem için yönetici (root) yetkisi gereklidir.")
        print(f"Lütfen komutu {COLOR_BOLD}sudo mindpkg ...{COLOR_RESET} şeklinde çalıştırın.")
        sys.exit(1)


PKG_NAME_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9.+_-]{0,127}$")


def valid_pkg_name(name):
    """Paket adı dosya yolu ya da komut seçeneği olarak kötüye kullanılamasın"""
    return bool(PKG_NAME_RE.match(name or ""))


def require_pkg_name(name):
    if not valid_pkg_name(name):
        print(f"{COLOR_RED}Hata:{COLOR_RESET} Geçersiz paket adı: {name!r}")
        sys.exit(1)


def safe_member_path(member):
    """Arşiv üyesini mutlak sistem yoluna çevirir; '..' içeren yolları reddeder"""
    clean = member.strip()
    while clean.startswith("./"):
        clean = clean[2:]
    clean = clean.lstrip("/")
    if not clean or clean == ".":
        return None
    if any(part == ".." for part in clean.split("/")):
        raise ValueError(f"güvensiz arşiv yolu: {member}")
    return "/" + clean.rstrip("/")


# Kaldırırken asla silinmeyecek dizinler
PROTECTED_PATHS = {"/", "/bin", "/boot", "/dev", "/etc", "/home", "/lib", "/lib64", "/opt", "/proc", "/root",
                   "/run", "/sbin", "/srv", "/sys", "/tmp", "/usr", "/usr/bin", "/usr/lib", "/usr/lib64",
                   "/usr/local", "/usr/local/bin", "/usr/sbin", "/usr/share", "/var", "/var/lib"}


def calculate_sha256(filepath):
    h = hashlib.sha256()
    with open(filepath, "rb") as f:
        while chunk := f.read(8192):
            h.update(chunk)
    return h.hexdigest()


def run_system_triggers():
    triggers = [
        ["ldconfig"],
        ["update-desktop-database", "-q", "/usr/share/applications"],
        ["gtk-update-icon-cache", "-q", "-t", "-f", "/usr/share/icons/hicolor"],
        ["glib-compile-schemas", "/usr/share/glib-2.0/schemas"]
    ]
    for cmd in triggers:
        if shutil.which(cmd[0]):
            try:
                subprocess.run(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            except Exception:
                pass


def download_with_progress(url, dest_path):
    """İlerleme çubuğu ile yerel veya uzak dosyayı kopyalar/indirir"""
    dest_path = Path(dest_path)
    dest_path.parent.mkdir(parents=True, exist_ok=True)

    if url.startswith("file://"):
        local_src = Path(url.replace("file://", ""))
        if local_src.exists():
            shutil.copyfile(local_src, dest_path)
            return
        else:
            raise FileNotFoundError(f"Yerel dosya bulunamadı: {local_src}")

    if not url.startswith("https://"):
        raise ValueError(f"güvensiz adres reddedildi (yalnızca https:// desteklenir): {url}")

    if "raw.githubusercontent.com" in url and "/pkgs/" in url:
        url = url.replace("raw.githubusercontent.com", "media.githubusercontent.com/media")
    
    if shutil.which("curl"):
        res = subprocess.run(["curl", "-sSL", "--fail", "--proto", "=https", "--proto-redir", "=https",
                              "-o", str(dest_path), url], check=False)
        if res.returncode == 0 and dest_path.exists() and dest_path.stat().st_size > 0:
            return
            
    req = urllib.request.Request(url, headers={"User-Agent": f"mindpkg/{VERSION} (MindOS)"})
    with urllib.request.urlopen(req, timeout=30) as response, open(dest_path, "wb") as f:
        shutil.copyfileobj(response, f)


def update_repos():
    """Uzak ve yerel MindOS depolarını günceller"""
    check_root()
    cfg = load_config()
    repos = cfg.get("repositories", [])
    print(f"{COLOR_GREEN}==>{COLOR_RESET} MindOS depoları eşitleniyor...")
    for repo in repos:
        if not repo.get("enabled", True):
            continue
        name = repo["name"]
        url = repo["url"]
        index_url = f"{url}/packages.json"
        dest_file = Path(REPOS_CACHE) / f"{name}.json"
        print(f"  {COLOR_ACCENT}• {name}:{COLOR_RESET} {index_url}")
        try:
            tmp_index = dest_file.with_suffix(".json.part")
            download_with_progress(index_url, tmp_index)
            json.load(open(tmp_index, encoding="utf-8"))  # bozuk indeksi kabul etme
            os.replace(tmp_index, dest_file)
            try:
                with open(dest_file, "r", encoding="utf-8") as df:
                    c = df.read()
                if "raw.githubusercontent.com" in c:
                    c = c.replace("https://raw.githubusercontent.com/MindOS-Official/packages/main/pkgs/x86_64/", "https://media.githubusercontent.com/media/MindOS-Official/packages/main/pkgs/x86_64/")
                    with open(dest_file, "w", encoding="utf-8") as df:
                        df.write(c)
            except Exception:
                pass
            print(f"    {COLOR_GREEN}✓ Başarıyla güncellendi.{COLOR_RESET}")
        except Exception as e:
            print(f"    {COLOR_BANNER}⚠ Depo güncellenemedi: {e}{COLOR_RESET}")


def install_mind_file(file_path):
    """Yerel bir .mind dosyasını sisteme kurar"""
    check_root()
    file_path = Path(file_path).resolve()
    if not file_path.exists():
        print(f"{COLOR_RED}Hata:{COLOR_RESET} Dosya bulunamadı: {file_path}")
        sys.exit(1)

    import tempfile
    with tempfile.TemporaryDirectory() as tmpdir:
        try:
            subprocess.run(["tar", "--zstd", "-xf", str(file_path), "-C", tmpdir], check=True)
        except subprocess.CalledProcessError:
            print(f"{COLOR_RED}Hata:{COLOR_RESET} {file_path} geçerli bir MindOS paketi değil!")
            sys.exit(1)

        meta_file = Path(tmpdir) / "metadata.json"
        if not meta_file.exists():
            print(f"{COLOR_RED}Hata:{COLOR_RESET} Pakette metadata.json bulunamadı!")
            sys.exit(1)

        with open(meta_file, "r", encoding="utf-8") as f:
            meta = json.load(f)

        pkg_name = meta.get("name", "")
        pkg_ver = meta.get("version", "1.0")
        if not valid_pkg_name(pkg_name):
            print(f"{COLOR_RED}Hata:{COLOR_RESET} Paket adı geçersiz: {pkg_name!r}")
            sys.exit(1)

        print(f"{COLOR_GREEN}==>{COLOR_RESET} Kuruluyor: {COLOR_BOLD}{pkg_name} ({pkg_ver}){COLOR_RESET} ...")

        # Sistem (dpkg) dosyalarının üzerine yazma kontrolü - kancalardan önce
        files_archive = Path(tmpdir) / "files.tar.zst"
        if files_archive.exists():
            listing = subprocess.check_output(["tar", "--zstd", "-tf", str(files_archive)], text=True)
            try:
                paths = [p for p in (safe_member_path(l) for l in listing.splitlines()) if p]
            except ValueError as e:
                print(f"{COLOR_RED}Hata:{COLOR_RESET} Paket reddedildi: {e}")
                sys.exit(1)
            conflicts = dpkg_owned_conflicts(paths)
            if conflicts and os.environ.get("MINDPKG_FORCE") != "1":
                print(f"{COLOR_RED}Hata:{COLOR_RESET} {pkg_name} sistem paketlerine ait {len(conflicts)} dosyanın üzerine yazacaktı:")
                for c in conflicts[:8]:
                    print(f"    {c}")
                print(f"  Sistemi korumak için kurulum durduruldu. Zorlamak için: {COLOR_BOLD}MINDPKG_FORCE=1 mindpkg install ...{COLOR_RESET}")
                sys.exit(1)

        # pre_install hook
        pre_install = Path(tmpdir) / "pre_install.sh"
        if pre_install.exists():
            os.chmod(pre_install, 0o755)
            subprocess.run([str(pre_install)], check=False)

        # Dosyaları çıkart ve listele
        files_archive = Path(tmpdir) / "files.tar.zst"
        installed_files = []
        if files_archive.exists():
            tar_list = subprocess.check_output(["tar", "--zstd", "-tf", str(files_archive)], text=True)
            for line in tar_list.splitlines():
                p = safe_member_path(line)
                if p:
                    installed_files.append(p)

            subprocess.run(["tar", "--zstd", "-xf", str(files_archive), "-C", "/",
                            "--no-same-owner", "--no-overwrite-dir"], check=True)

        # post_install hook
        post_install = Path(tmpdir) / "post_install.sh"
        if post_install.exists():
            os.chmod(post_install, 0o755)
            subprocess.run([str(post_install)], check=False)

        # Veritabanına kaydet
        meta["installed_files"] = installed_files
        pkg_record = Path(INSTALLED_DIR) / f"{pkg_name}.json"
        with open(pkg_record, "w", encoding="utf-8") as f:
            json.dump(meta, f, indent=4)

        run_system_triggers()
        print(f"{COLOR_GREEN}✓ Tamamlandı:{COLOR_RESET} {pkg_name} ({pkg_ver}) sisteme kuruldu.")


# Üçüncü taraf uygulamalar: üreticinin resmi, imzalı apt deposundan kurulur
VENDOR_APPS = {
    "google-chrome-stable": {
        "aliases": ["chrome", "google-chrome"],
        "source": "deb [arch=amd64 signed-by=/usr/share/keyrings/google-chrome.asc] https://dl.google.com/linux/chrome/deb/ stable main",
        "list": "/etc/apt/sources.list.d/google-chrome.list",
        "key_url": "https://dl.google.com/linux/linux_signing_key.pub",
        "keyring": "/usr/share/keyrings/google-chrome.asc",
    },
    "code": {
        "aliases": ["vscode", "visual-studio-code"],
        "source": "deb [arch=amd64 signed-by=/usr/share/keyrings/microsoft.asc] https://packages.microsoft.com/repos/code stable main",
        "list": "/etc/apt/sources.list.d/vscode.list",
        "key_url": "https://packages.microsoft.com/keys/microsoft.asc",
        "keyring": "/usr/share/keyrings/microsoft.asc",
    },
}
_apt_updated = False

# Debian deposunda adı farklı olan paketler
APT_ALIASES = {
    "firefox": "firefox-esr",
}


def resolve_vendor_app(name):
    """Takma adı (chrome, vscode ...) gerçek paket adına çevirir"""
    for pkg, spec in VENDOR_APPS.items():
        if name == pkg or name in spec["aliases"]:
            return pkg, spec
    return None, None


def apt_update_once():
    global _apt_updated
    if not _apt_updated:
        print(f"  {COLOR_ACCENT}Sistem paket listeleri güncelleniyor...{COLOR_RESET}")
        subprocess.run(["apt-get", "update", "-qq"], check=False)
        _apt_updated = True


def apt_has_candidate(pkg):
    out = subprocess.run(["apt-cache", "policy", pkg], capture_output=True, text=True,
                         env={**os.environ, "LANG": "C"}).stdout
    for line in out.splitlines():
        if line.strip().startswith("Candidate:"):
            return line.split(":", 1)[1].strip() not in ("", "(none)")
    return False


def install_from_system(name):
    """mindpkg deposunda olmayan paketi üretici deposu veya Debian deposundan kurar"""
    if not shutil.which("apt-get"):
        return False
    pkg, spec = resolve_vendor_app(name)
    if spec:
        if not Path(spec["keyring"]).exists():
            print(f"{COLOR_GREEN}==>{COLOR_RESET} Resmi üretici deposu ekleniyor: {COLOR_BOLD}{spec['source'].split()[-3]}{COLOR_RESET}")
            download_with_progress(spec["key_url"], spec["keyring"])
            os.chmod(spec["keyring"], 0o644)
        if not Path(spec["list"]).exists():
            Path(spec["list"]).write_text(spec["source"] + "\n", encoding="utf-8")
        global _apt_updated
        _apt_updated = False
    else:
        pkg = APT_ALIASES.get(name, name)
    apt_update_once()
    if not apt_has_candidate(pkg):
        return False
    print(f"{COLOR_GREEN}==>{COLOR_RESET} Sistem deposundan kuruluyor: {COLOR_BOLD}{pkg}{COLOR_RESET} ...")
    res = subprocess.run(["apt-get", "install", "-y", "--", pkg],
                         env={**os.environ, "DEBIAN_FRONTEND": "noninteractive"})
    if res.returncode != 0:
        print(f"{COLOR_RED}Hata:{COLOR_RESET} '{pkg}' kurulamadı (apt-get çıkış kodu {res.returncode}).")
        sys.exit(res.returncode)
    run_system_triggers()
    print(f"{COLOR_GREEN}✓ Tamamlandı:{COLOR_RESET} {pkg} sisteme kuruldu.")
    return True


def find_in_index(pkg_name):
    """Yerel depo indekslerinde paketi arar; snap yönlendirme paketlerini yok sayar"""
    for r in Path(REPOS_CACHE).glob("*.json"):
        try:
            with open(r, "r", encoding="utf-8") as f:
                repo_data = json.load(f)
        except Exception:
            continue
        for pkg in repo_data.get("packages", []):
            if pkg.get("name") == pkg_name and "snap" not in str(pkg.get("version", "")):
                return pkg
    return None


def dpkg_owned_conflicts(paths):
    """Sistem paket yöneticisine (dpkg) ait olup üzerine yazılacak dosyaları döndürür"""
    info = Path("/var/lib/dpkg/info")
    if not info.is_dir():
        return []
    owned = set()
    for lst in info.glob("*.list"):
        try:
            owned.update(lst.read_text(encoding="utf-8", errors="replace").splitlines())
        except Exception:
            pass
    merged = {"/bin": "/usr/bin", "/sbin": "/usr/sbin", "/lib": "/usr/lib", "/lib64": "/usr/lib64"}
    conflicts = []
    for p in paths:
        if p.endswith("/") or not os.path.lexists(p) or os.path.isdir(p):
            continue
        alts = {p}
        for short, full in merged.items():
            if p.startswith(full + "/"):
                alts.add(short + p[len(full):])
            elif p.startswith(short + "/"):
                alts.add(full + p[len(short):])
        if alts & owned:
            conflicts.append(p)
    return conflicts


def fetch_verified(pkg_name, target_meta):
    """Depo kaydındaki .mind dosyasını indirir, SHA256 ile doğrular ve önbellek yolunu döndürür"""
    url = target_meta.get("url") or ""
    filename = Path(target_meta.get("filename") or f"{pkg_name}.mind").name
    expected_sha256 = (target_meta.get("sha256") or "").lower()
    if not re.fullmatch(r"[0-9a-f]{64}", expected_sha256) or not filename.endswith(".mind"):
        print(f"{COLOR_RED}Hata:{COLOR_RESET} '{pkg_name}' için depo kaydı eksik ya da geçersiz (SHA256 yok). Güvenlik için kurulmadı.")
        sys.exit(1)
    cached_file = Path(CACHE_DIR) / filename

    print(f"{COLOR_GREEN}==>{COLOR_RESET} İndiriliyor: {COLOR_BOLD}{pkg_name} {target_meta.get('version')}{COLOR_RESET} ...")
    print(f"  {COLOR_ACCENT}Kaynak:{COLOR_RESET} {url}")
    try:
        download_with_progress(url, cached_file)
    except Exception as e:
        cached_file.unlink(missing_ok=True)
        print(f"{COLOR_RED}Hata:{COLOR_RESET} '{pkg_name}' MindOS deposundan indirilemedi: {e}")
        sys.exit(1)

    if expected_sha256:
        print(f"  {COLOR_ACCENT}Doğrulanıyor (SHA256)...{COLOR_RESET}")
        actual_sha256 = calculate_sha256(cached_file)
        if actual_sha256 != expected_sha256:
            print(f"{COLOR_RED}Hata:{COLOR_RESET} SHA256 doğrulama başarısız! Dosya bozulmuş olabilir.")
            cached_file.unlink(missing_ok=True)
            sys.exit(1)
        print(f"  {COLOR_GREEN}✓ İmza doğrulandı.{COLOR_RESET}")

    return cached_file


def install_from_repo_or_name(pkg_name):
    """Depolarda paket adını arar, indirir, SHA256 doğrular ve kurar"""
    check_root()
    require_pkg_name(pkg_name)
    # Debian tabanlı sistemlerde (MindOS Paradise) önce üreticinin resmi deposu ve
    # sisteme özel derlenmiş Debian paketi denenir; yoksa MindOS .mind deposuna geçilir.
    if shutil.which("apt-get") and install_from_system(pkg_name):
        return

    target_meta = find_in_index(pkg_name)
    if not target_meta:
        print(f"{COLOR_BANNER}Paket yerel önbellekte bulunamadı, depolar güncelleniyor...{COLOR_RESET}")
        update_repos()
        target_meta = find_in_index(pkg_name)

    if not target_meta:
        print(f"{COLOR_RED}Hata:{COLOR_RESET} '{pkg_name}' resmi MindOS depolarında bulunamadı.")
        if shutil.which("flatpak"):
            print(f"{COLOR_ACCENT}İpucu:{COLOR_RESET} Bu uygulama Flathub üzerinde olabilir: 'flatpak search {pkg_name}'")
        sys.exit(1)

    install_mind_file(fetch_verified(pkg_name, target_meta))


def delete_tracked_files(paths):
    """mindpkg'nin kurduğu dosyaları siler; dpkg'ye ait dosyalara ve sistem dizinlerine dokunmaz"""
    files = [f for f in paths if isinstance(f, str) and f.startswith("/")
             and ".." not in f.split("/") and f.rstrip("/") not in PROTECTED_PATHS]
    shared = set(dpkg_owned_conflicts(files))
    for file_path in sorted(files, key=len, reverse=True):
        if file_path in shared:
            continue  # bu dosya bir sistem paketine ait, silinmez
        p = Path(file_path)
        try:
            if p.is_symlink() or p.is_file():
                p.unlink(missing_ok=True)
            elif p.is_dir():
                if not any(p.iterdir()):
                    p.rmdir()
        except Exception:
            pass


def remove_package(pkg_name):
    """Sistemden kurulu bir paketi temiz bir şekilde kaldırır"""
    check_root()
    require_pkg_name(pkg_name)
    pkg_record = Path(INSTALLED_DIR) / f"{pkg_name}.json"
    if not pkg_record.exists():
        sys_pkg = resolve_vendor_app(pkg_name)[0] or pkg_name
        st = subprocess.run(["dpkg-query", "-W", "-f=${db:Status-Abbrev}", sys_pkg],
                            capture_output=True, text=True).stdout
        if st.startswith("ii") and shutil.which("apt-get"):
            print(f"{COLOR_RED}==>{COLOR_RESET} Sistem paketi kaldırılıyor: {COLOR_BOLD}{sys_pkg}{COLOR_RESET} ...")
            res = subprocess.run(["apt-get", "remove", "-y", "--", sys_pkg],
                                 env={**os.environ, "DEBIAN_FRONTEND": "noninteractive"})
            if res.returncode == 0:
                run_system_triggers()
                print(f"{COLOR_GREEN}✓ Tamamlandı:{COLOR_RESET} {sys_pkg} sistemden kaldırıldı.")
            sys.exit(res.returncode)
        print(f"{COLOR_RED}Hata:{COLOR_RESET} '{pkg_name}' sistemde kurulu değil!")
        sys.exit(1)

    with open(pkg_record, "r", encoding="utf-8") as f:
        meta = json.load(f)

    print(f"{COLOR_RED}==>{COLOR_RESET} Kaldırılıyor: {COLOR_BOLD}{pkg_name} ({meta.get('version')}){COLOR_RESET} ...")

    delete_tracked_files(meta.get("installed_files", []))

    pkg_record.unlink(missing_ok=True)
    run_system_triggers()
    print(f"{COLOR_GREEN}✓ Tamamlandı:{COLOR_RESET} {pkg_name} sistemden kaldırıldı.")


def list_installed():
    """Kurulu paketleri listeler"""
    records = list(Path(INSTALLED_DIR).glob("*.json"))
    if not records:
        print(f"{COLOR_ACCENT}Sistemde mindpkg ile kurulmuş paket bulunmuyor.{COLOR_RESET}")
        return

    print(f"{COLOR_BOLD}{'Paket Adı':<25} {'Sürüm':<15} {'Açıklama'}{COLOR_RESET}")
    print(f"{'-'*70}")
    for r in sorted(records):
        try:
            with open(r, "r", encoding="utf-8") as f:
                meta = json.load(f)
            name = meta.get("name", r.stem)
            ver = meta.get("version", "-")
            desc = meta.get("description", "-")
            print(f"{COLOR_GREEN}{name:<25}{COLOR_RESET} {ver:<15} {desc}")
        except Exception:
            pass


def info_package(pkg_name):
    """Paket hakkında detaylı bilgi gösterir"""
    require_pkg_name(pkg_name)
    pkg_record = Path(INSTALLED_DIR) / f"{pkg_name}.json"
    if pkg_record.exists():
        with open(pkg_record, "r", encoding="utf-8") as f:
            meta = json.load(f)
        print(f"{COLOR_BOLD}Paket Adı:{COLOR_RESET}     {meta.get('name')}")
        print(f"{COLOR_BOLD}Sürüm:{COLOR_RESET}         {meta.get('version')}")
        print(f"{COLOR_BOLD}Açıklama:{COLOR_RESET}      {meta.get('description')}")
        print(f"{COLOR_BOLD}Mimari:{COLOR_RESET}        {meta.get('architecture', 'all')}")
        print(f"{COLOR_BOLD}Durum:{COLOR_RESET}         {COLOR_GREEN}Kurulu{COLOR_RESET}")
        print(f"{COLOR_BOLD}Dosya Sayısı:{COLOR_RESET}  {len(meta.get('installed_files', []))}")
        return

    for r in Path(REPOS_CACHE).glob("*.json"):
        try:
            with open(r, "r", encoding="utf-8") as f:
                repo_data = json.load(f)
            for pkg in repo_data.get("packages", []):
                if pkg.get("name") == pkg_name:
                    print(f"{COLOR_BOLD}Paket Adı:{COLOR_RESET}     {pkg.get('name')}")

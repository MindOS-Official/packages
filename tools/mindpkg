def _version_key(text):
    """dpkg yoksa kullanılan basit sürüm karşılaştırma anahtarı"""
    return [(0, int(t), "") if t.isdigit() else (1, 0, t) for t in re.findall(r"\d+|[A-Za-z]+", str(text))]


def is_newer(candidate, current):
    """candidate sürümü current'tan yeni mi? (Debian sürüm kuralları)"""
    if candidate == current:
        return False
    if shutil.which("dpkg"):
        return subprocess.run(["dpkg", "--compare-versions", str(candidate), "gt", str(current)]).returncode == 0
    return _version_key(candidate) > _version_key(current)


def full_version(meta):
    return f"{meta.get('version', '0')}-{meta.get('release', '1')}"


def latest_mindpkg_release():
    """Depo indekslerindeki en yeni mindpkg sürüm kaydını döndürür"""
    best = None
    for r in Path(REPOS_CACHE).glob("*.json"):
        try:
            with open(r, "r", encoding="utf-8") as f:
                entry = json.load(f).get("mindpkg")
        except Exception:
            continue
        if isinstance(entry, dict) and entry.get("version") and (best is None or is_newer(entry["version"], best["version"])):
            best = entry
    return best


def self_update():
    """Yeni mindpkg sürümü varsa indirir, doğrular, kendini değiştirir ve yeni sürümle devam eder"""
    print(f"{COLOR_GREEN}==>{COLOR_RESET} mindpkg güncellemesi denetleniyor...")
    rel = latest_mindpkg_release()
    if not rel or not is_newer(rel["version"], VERSION):
        print(f"  {COLOR_GREEN}✓{COLOR_RESET} mindpkg güncel (v{VERSION}).")
        return
    new_ver, url = str(rel["version"]), str(rel.get("url", ""))
    sha = str(rel.get("sha256", "")).lower()
    if not re.fullmatch(r"[0-9a-f]{64}", sha) or not re.fullmatch(r"[0-9A-Za-z.+~-]+", new_ver):
        print(f"  {COLOR_RED}⚠ mindpkg {new_ver} kaydı geçersiz (SHA256 yok), atlanıyor.{COLOR_RESET}")
        return
    self_path = Path(os.path.realpath(__file__))
    print(f"  {COLOR_ACCENT}Yeni sürüm:{COLOR_RESET} v{VERSION} → {COLOR_BOLD}v{new_ver}{COLOR_RESET}")
    fd, tmp = tempfile.mkstemp(prefix=".mindpkg-", dir=str(self_path.parent))
    os.close(fd)
    tmp = Path(tmp)
    try:
        download_with_progress(url, tmp)
        if calculate_sha256(tmp) != sha:
            raise ValueError("SHA256 doğrulaması başarısız")
        code = tmp.read_text(encoding="utf-8")
        compile(code, str(tmp), "exec")  # sözdizimi bozuk bir dosya asla kurulmaz
        if f'VERSION = "{new_ver}"' not in code:
            raise ValueError("indirilen dosyanın sürümü beklenenle uyuşmuyor")
        shutil.copy2(self_path, Path(DB_DIR) / "mindpkg.previous")  # geri dönüş için
        os.chmod(tmp, 0o755)
        os.replace(tmp, self_path)
    except Exception as e:
        tmp.unlink(missing_ok=True)
        print(f"  {COLOR_RED}⚠ mindpkg güncellenemedi: {e}{COLOR_RESET}")
        return
    print(f"  {COLOR_GREEN}✓ mindpkg v{new_ver} kuruldu, yükseltme yeni sürümle sürüyor...{COLOR_RESET}\n")
    sys.stdout.flush()
    os.execv(sys.executable, [sys.executable, str(self_path), "upgrade", "--no-self-update", "--resumed",
                              *[a for a in sys.argv[2:] if a not in ("--no-self-update", "--resumed")]])


def upgrade_mind_packages():
    """Kurulu .mind paketlerinden depoda yenisi olanları yükseltir"""
    print(f"{COLOR_GREEN}==>{COLOR_RESET} MindOS (.mind) paketleri denetleniyor...")
    pending = []
    for rec in sorted(Path(INSTALLED_DIR).glob("*.json")):
        try:
            with open(rec, "r", encoding="utf-8") as f:
                old = json.load(f)
        except Exception:
            continue
        name = old.get("name", rec.stem)
        new = find_in_index(name) if valid_pkg_name(name) else None
        if new and is_newer(full_version(new), full_version(old)):
            pending.append((name, old, new))
    if not pending:
        print(f"  {COLOR_GREEN}✓{COLOR_RESET} Tüm .mind paketleri güncel.")
        return 0
    for name, old, new in pending:
        print(f"  • {COLOR_BOLD}{name}{COLOR_RESET} {full_version(old)} → {full_version(new)}")
    for name, old, new in pending:
        install_mind_file(fetch_verified(name, new))
        with open(Path(INSTALLED_DIR) / f"{name}.json", "r", encoding="utf-8") as f:
            now = set(json.load(f).get("installed_files", []))
        # eski sürümde olup yenisinde olmayan dosyalar temizlenir
        delete_tracked_files([p for p in old.get("installed_files", []) if p not in now])
    return len(pending)


def upgrade_system_packages():
    """apt/üretici deposundan kurulan uygulamaları (Chrome, VS Code, Debian paketleri) yükseltir"""
    if not shutil.which("apt-get"):
        return
    print(f"{COLOR_GREEN}==>{COLOR_RESET} Sistem paketleri güncelleniyor (apt)...")
    env = {**os.environ, "DEBIAN_FRONTEND": "noninteractive"}
    subprocess.run(["apt-get", "update", "-qq"], env=env, check=False)
    res = subprocess.run(["apt-get", "-y", "-o", "Dpkg::Options::=--force-confold", "--with-new-pkgs", "upgrade"],
                         env=env)
    if res.returncode != 0:
        print(f"  {COLOR_RED}⚠ apt yükseltmesi hata verdi (çıkış kodu {res.returncode}).{COLOR_RESET}")


def upgrade_all(args):
    """mindpkg upgrade: önce mindpkg'nin kendisi, sonra .mind paketleri, sonra sistem paketleri"""
    check_root()
    if "--resumed" not in args:  # yeni sürümle devam ediliyorsa indeksler zaten taze
        update_repos()
    if "--no-self-update" not in args:
        self_update()
    upgrade_mind_packages()
    if "--no-apt" not in args:
        upgrade_system_packages()
    run_system_triggers()
    print(f"\n{COLOR_GREEN}✓ Yükseltme tamamlandı.{COLOR_RESET}")


def main():
    print_banner()
    ensure_directories()

    if len(sys.argv) < 2:
        print(f"{COLOR_BOLD}Kullanım:{COLOR_RESET} mindpkg <komut> [seçenekler] [argümanlar...]\n")
        print("Temel Komutlar:")
        print(f"  {COLOR_GREEN}install, add, i{COLOR_RESET} <paket | dosya.mind>     Paket kurar (Depodan veya yerel)")
        print(f"  {COLOR_GREEN}remove, rm, del{COLOR_RESET} <paket>                         Paket kaldırır")
        print(f"  {COLOR_GREEN}update, sync, up{COLOR_RESET}                              Depoları günceller")
        print(f"  {COLOR_GREEN}upgrade{COLOR_RESET} [--no-apt]                              mindpkg'yi ve tüm paketleri yükseltir")
        print(f"  {COLOR_GREEN}search, s{COLOR_RESET} <kelime>                              Paket arar")
        print(f"  {COLOR_GREEN}list, ls{COLOR_RESET}                                      Kurulu paketleri listeler")
        print(f"  {COLOR_GREEN}info, show{COLOR_RESET} <paket>                              Paket bilgisini gösterir")
        print(f"  {COLOR_GREEN}build{COLOR_RESET} <kaynak_dizini>                         .mind paketi derler")
        print(f"  {COLOR_GREEN}clean{COLOR_RESET}                                         Önbelleği temizler")
        sys.exit(0)

    cmd = sys.argv[1].lower()
    args = sys.argv[2:]

    if cmd in ["install", "add", "i"]:
        if not args:
            print(f"{COLOR_RED}Hata:{COLOR_RESET} Kurulacak paket adı belirtilmedi.")
            sys.exit(1)
        for target in args:
            if target.endswith(".mind") or os.path.exists(target):
                install_mind_file(target)
            else:
                install_from_repo_or_name(target)

    elif cmd in ["remove", "rm", "del", "uninstall"]:
        if not args:
            print(f"{COLOR_RED}Hata:{COLOR_RESET} Kaldırılacak paket adı belirtilmedi.")
            sys.exit(1)
        for pkg in args:
            remove_package(pkg)

    elif cmd in ["update", "sync", "up"]:
        update_repos()

    elif cmd in ["upgrade", "full-upgrade", "dist-upgrade"]:
        upgrade_all(args)

    elif cmd in ["version", "--version", "-v"]:
        print(VERSION)

    elif cmd in ["search", "s", "find"]:
        if not args:
            print(f"{COLOR_RED}Hata:{COLOR_RESET} Aranacak kelime belirtilmedi.")
            sys.exit(1)
        search_repos(" ".join(args))

    elif cmd in ["list", "ls"]:
        list_installed()

    elif cmd in ["info", "show"]:
        if not args:
            print(f"{COLOR_RED}Hata:{COLOR_RESET} Paket adı belirtilmedi.")
            sys.exit(1)
        info_package(args[0])

    elif cmd in ["build", "pkg-build"]:
        src = args[0] if args else "."
        out = args[1] if len(args) > 1 else None
        build_package(src, out)

    elif cmd in ["clean", "gc"]:
        check_root()
        shutil.rmtree(CACHE_DIR, ignore_errors=True)
        ensure_directories()
        print(f"{COLOR_GREEN}✓ Önbellek temizlendi.{COLOR_RESET}")

    else:
        print(f"{COLOR_RED}Bilinmeyen komut:{COLOR_RESET} {cmd}")
        print("Yardım için: 'mindpkg' yazın.")


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        print(f"\n\n{COLOR_YELLOW}⚠ İşlem kullanıcı tarafından iptal edildi.{COLOR_RESET}")
        sys.exit(130)

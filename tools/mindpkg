    print(f"{COLOR_RED}Hata:{COLOR_RESET} '{pkg_name}' bulunamadı.")


def search_repos(query):
    """Depolarda ve yerel paketlerde arama yapar"""
    query = query.lower()
    print(f"{COLOR_ACCENT}==>{COLOR_RESET} Aranıyor: '{COLOR_BOLD}{query}{COLOR_RESET}' ...\n")
    found = False

    for r in Path(INSTALLED_DIR).glob("*.json"):
        try:
            with open(r, "r", encoding="utf-8") as f:
                meta = json.load(f)
            name = meta.get("name", "")
            desc = meta.get("description", "")
            if query in name.lower() or query in desc.lower():
                print(f"  {COLOR_GREEN}{name}{COLOR_RESET} {meta.get('version')} [{COLOR_ACCENT}kurulu{COLOR_RESET}]")
                print(f"    {desc}\n")
                found = True
        except Exception:
            pass

    for r in Path(REPOS_CACHE).glob("*.json"):
        try:
            with open(r, "r", encoding="utf-8") as f:
                repo_data = json.load(f)
            for pkg in repo_data.get("packages", []):
                name = pkg.get("name", "")
                desc = pkg.get("description", "")
                if query in name.lower() or query in desc.lower():
                    print(f"  {COLOR_GREEN}{name}{COLOR_RESET} {pkg.get('version')} [{r.stem}]")
                    print(f"    {desc}\n")
                    found = True
        except Exception:
            pass

    if not found:
        print(f"'{query}' ile eşleşen bir paket bulunamadı.")


def build_package(source_dir, output_file=None):
    """Bir dizinden resmi .mind paketi inşa eder"""
    src_path = Path(source_dir).resolve()
    meta_file = src_path / "metadata.json"
    files_dir = src_path / "rootfs"

    if not meta_file.exists():
        print(f"{COLOR_RED}Hata:{COLOR_RESET} {meta_file} bulunamadı!")
        sys.exit(1)

    with open(meta_file, "r", encoding="utf-8") as f:
        meta = json.load(f)

    pkg_name = meta.get("name", "unnamed")
    pkg_ver = meta.get("version", "1.0.0")
    pkg_rel = meta.get("release", "1")
    pkg_arch = meta.get("architecture", "x86_64")

    if not output_file:
        output_file = f"{pkg_name}-{pkg_ver}-{pkg_rel}-{pkg_arch}.mind"

    print(f"{COLOR_GREEN}==>{COLOR_RESET} Paket derleniyor: {COLOR_BOLD}{output_file}{COLOR_RESET} ...")

    import tempfile
    with tempfile.TemporaryDirectory() as tmpdir:
        tmp_path = Path(tmpdir)
        shutil.copy2(meta_file, tmp_path / "metadata.json")

        for hook in ["pre_install.sh", "post_install.sh", "pre_remove.sh", "post_remove.sh"]:
            h_file = src_path / hook
            if h_file.exists():
                shutil.copy2(h_file, tmp_path / hook)

        files_archive = tmp_path / "files.tar.zst"
        if files_dir.exists():
            subprocess.run(["tar", "--zstd", "-cf", str(files_archive), "--owner=0", "--group=0", "--numeric-owner",
                            "-C", str(files_dir), "."], check=True)
        else:
            subprocess.run(["tar", "--zstd", "-cf", str(files_archive), "--files-from", "/dev/null"], check=True)

        subprocess.run(["tar", "--zstd", "-cf", str(Path(output_file).resolve()), "-C", str(tmp_path), "."], check=True)

    print(f"{COLOR_GREEN}✓ BAŞARILI:{COLOR_RESET} {output_file} hazırlandı! ({os.path.getsize(output_file):,} bayt)")



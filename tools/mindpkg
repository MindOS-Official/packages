                    print(f"{COLOR_BOLD}Mimari:{COLOR_RESET}        {pkg.get('architecture', 'all')}")
                    print(f"{COLOR_BOLD}Durum:{COLOR_RESET}         {COLOR_ACCENT}Depoda Mevcut ({r.stem}){COLOR_RESET}")
                    print(f"{COLOR_BOLD}Paket Boyutu:{COLOR_RESET}  {pkg.get('size', 0):,} bayt")

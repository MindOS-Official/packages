    # --------------------------------------------------------------------------
    # Logic & Navigation
    # --------------------------------------------------------------------------
    def scan_system_disks(self):
        try:
            out = subprocess.check_output(["lsblk", "-d", "-p", "-n", "-l", "-o", "NAME,SIZE,MODEL,TYPE"], text=True)
            self.disks_data = []
            while self.disk_model_store.get_n_items() > 0:
                self.disk_model_store.remove(0)

            for line in out.strip().splitlines():
                if "disk" in line and not "loop" in line:
                    parts = line.split()
                    dev = parts[0]
                    size = parts[1] if len(parts) > 1 else ""
                    model = " ".join(parts[2:-1]) if len(parts) > 3 else "Depolama Sürücüsü"
                    display_name = f"{model} ({size}) - {dev}"
                    self.disks_data.append({"dev": dev, "size": size, "model": model, "display": display_name})
                    self.disk_model_store.append(display_name)

            if self.disks_data:
                self.selected_disk = self.disks_data[0]["dev"]
        except Exception as e:
            print("Disk scan error:", e)

    def on_disk_selected(self, combo, param):
        idx = combo.get_selected()
        if 0 <= idx < len(self.disks_data):
            self.selected_disk = self.disks_data[idx]["dev"]

    def on_install_mode_toggled(self, check):
        if check.get_active():
            self.install_mode = "erase_disk"
            self.disk_combo.set_sensitive(True)
            self.group_manual.set_visible(False)
        else:
            self.install_mode = "manual"
            self.disk_combo.set_sensitive(False)
            self.group_manual.set_visible(True)

    def on_back_clicked(self, btn):
        curr = self.stack.get_visible_child_name()
        order = ["welcome", "disk", "user", "summary", "installing", "finished"]
        idx = order.index(curr)
        if idx > 0:
            self.stack.set_visible_child_name(order[idx - 1])
            self.btn_back.set_sensitive(idx - 1 > 0)
            self.btn_next.set_label("İleri")

    def on_next_clicked(self, btn):
        curr = self.stack.get_visible_child_name()
        order = ["welcome", "disk", "user", "summary", "installing", "finished"]
        idx = order.index(curr)

        if curr == "welcome":
            self.stack.set_visible_child_name("disk")
            self.btn_back.set_sensitive(True)

        elif curr == "disk":
            if self.install_mode == "erase_disk" and not self.selected_disk:
                self.show_error("Lütfen bir hedef disk seçin!")
                return
            self.stack.set_visible_child_name("user")

        elif curr == "user":
            p1 = self.entry_pass.get_text()
            p2 = self.entry_pass_confirm.get_text()
            if p1 != p2:
                self.show_error("Girdiğiniz parolalar birbiriyle eşleşmiyor!")
                return
            self.username = self.entry_user.get_text().strip() or "mindos"
            self.hostname = self.entry_host.get_text().strip() or "mindos-sunrise"
            self.password = p1
            self.auto_login = self.switch_autologin.get_active()

            # Update Summary Page
            if self.install_mode == "erase_disk":
                self.sum_disk.set_subtitle(f"{self.selected_disk}")
                self.sum_mode.set_subtitle("Tüm disk temizlenecek, GPT + ESP + Root oluşturulacak")
            else:
                self.sum_disk.set_subtitle(f"Root: {self.entry_root.get_text()} / ESP: {self.entry_esp.get_text()}")
                self.sum_mode.set_subtitle("Mevcut bölümlere manuel kurulum yapılacak")

            self.sum_user.set_subtitle(f"{self.username} ({self.hostname})")
            self.btn_next.set_label("Şimdi Kur")
            self.stack.set_visible_child_name("summary")

        elif curr == "summary":
            # Start installation!
            self.btn_back.set_sensitive(False)
            self.btn_next.set_sensitive(False)
            self.action_bar.set_visible(False)
            self.header_bar.set_show_title_buttons(False)
            self.stack.set_visible_child_name("installing")
            threading.Thread(target=self.run_installation, daemon=True).start()
            threading.Thread(target=self.run_slideshow, daemon=True).start()

    def show_error(self, message):
        dialog = Adw.MessageDialog(heading="Hata", body=message, transient_for=self)
        dialog.add_response("ok", "Tamam")
        dialog.present()

    def run_slideshow(self):
        slides = ["slide1", "slide2", "slide3"]
        i = 0
        while self.stack.get_visible_child_name() == "installing":
            time.sleep(8)
            i = (i + 1) % len(slides)
            GLib.idle_add(self.slide_stack.set_visible_child_name, slides[i])

    # --------------------------------------------------------------------------
    # Installation Execution Engine
    # --------------------------------------------------------------------------
    def run_installation(self):
        try:
            self.update_progress(0.05, "Disk hazırlanıyor...")
            target_disk = self.selected_disk

            if self.install_mode == "erase_disk":
                # Wipe & Partition GPT
                subprocess.run(["wipefs", "-a", target_disk], check=True)
                subprocess.run(["parted", "-s", target_disk, "mklabel", "gpt"], check=True)
                subprocess.run(["parted", "-s", target_disk, "mkpart", "primary", "1MiB", "2MiB"], check=True)
                subprocess.run(["parted", "-s", target_disk, "set", "1", "bios_grub", "on"], check=True)
                subprocess.run(["parted", "-s", target_disk, "mkpart", "primary", "fat32", "2MiB", "514MiB"], check=True)
                subprocess.run(["parted", "-s", target_disk, "set", "2", "esp", "on"], check=True)
                subprocess.run(["parted", "-s", target_disk, "mkpart", "primary", "ext4", "514MiB", "100%"], check=True)

                if target_disk[-1].isdigit():
                    part_esp = f"{target_disk}p2"
                    part_root = f"{target_disk}p3"
                else:
                    part_esp = f"{target_disk}2"
                    part_root = f"{target_disk}3"

                subprocess.run(["partprobe", target_disk], check=False)
                time.sleep(2)

                self.update_progress(0.15, "Dosya sistemleri biçimlendiriliyor (FAT32 + Ext4)...")
                subprocess.run(["mkfs.vfat", "-F32", "-n", "MINDOS_ESP", part_esp], check=True)
                subprocess.run(["mkfs.ext4", "-F", "-L", "MindOS_Sunrise", part_root], check=True)
            else:
                part_root = self.entry_root.get_text().strip()
                part_esp = self.entry_esp.get_text().strip()

            self.update_progress(0.25, "Diskler bağlanıyor...")
            target_mount = Path("/mnt/mindos_target")
            target_mount.mkdir(parents=True, exist_ok=True)
            subprocess.run(["mount", part_root, str(target_mount)], check=True)
            (target_mount / "boot" / "efi").mkdir(parents=True, exist_ok=True)
            if part_esp:
                subprocess.run(["mount", part_esp, str(target_mount / "boot" / "efi")], check=True)

            self.update_progress(0.35, "MindOS Sunrise diske kopyalanıyor (bu işlem 2-3 dakika sürebilir)...")
            rsync_cmd = [
                "rsync", "-aHAXx",
                "--exclude=/proc/*",
                "--exclude=/sys/*",
                "--exclude=/dev/*",
                "--exclude=/run/*",
                "--exclude=/tmp/*",
                "--exclude=/mnt/*",
                "--exclude=/media/*",
                "--exclude=/lost+found",
                "/", f"{target_mount}/"
            ]
            subprocess.run(rsync_cmd, check=True)

            self.update_progress(0.75, "Kullanıcı hesabı ve sistem yapılandırması ayarlanıyor...")
            for d in ["proc", "sys", "dev", "run", "tmp", "mnt"]:
                (target_mount / d).mkdir(parents=True, exist_ok=True)
            os.chmod(target_mount / "tmp", 0o1777)

            # fstab
            root_uuid = subprocess.check_output(["blkid", "-s", "UUID", "-o", "value", part_root], text=True).strip()
            esp_uuid = subprocess.check_output(["blkid", "-s", "UUID", "-o", "value", part_esp], text=True).strip() if part_esp else ""

            fstab_content = f"UUID={root_uuid}    /            ext4    defaults,noatime    1 1\n"
            if esp_uuid:
                fstab_content += f"UUID={esp_uuid}     /boot/efi    vfat    defaults            0 2\n"
            with open(target_mount / "etc" / "fstab", "w") as f:
                f.write(fstab_content)

            # Hostname
            with open(target_mount / "etc" / "hostname", "w") as f:
                f.write(f"{self.hostname}\n")

            self.update_progress(0.85, "GRUB2 Önyükleyici kuruluyor (UEFI + BIOS)...")
            for fs in ["dev", "dev/pts", "proc", "sys"]:
                subprocess.run(["mount", "--bind", f"/{fs}", f"{target_mount}/{fs}"], check=False)
            subprocess.run(["mount", "-t", "tmpfs", "tmpfs", f"{target_mount}/run"], check=False)

            if part_esp:
                subprocess.run(["chroot", str(target_mount), "grub-install", "--target=x86_64-efi",
                                "--efi-directory=/boot/efi", "--bootloader-id=MindOS_Sunrise", "--recheck"], check=False)
            subprocess.run(["chroot", str(target_mount), "grub-install", "--target=i386-pc",
                            "--recheck", target_disk], check=False)

            grub_cfg = f"""set default=0
set timeout=5

insmod part_gpt
insmod part_msdos
insmod ext2
insmod fat
insmod all_video

menuentry 'MindOS Sunrise v1.0 (Kernel 7.0)' {{
    search --no-floppy --fs-uuid --set=root {root_uuid}
    linux /boot/vmlinuz-7.0.0-mindos-sunrise-v1 root=UUID={root_uuid} rw quiet splash init=/lib/systemd/systemd console=tty0
    initrd /boot/initramfs-7.0.0-mindos-sunrise-v1.img
}}

menuentry 'MindOS Sunrise v1.0 (Kurtarma / Recovery Modu)' {{
    search --no-floppy --fs-uuid --set=root {root_uuid}
    linux /boot/vmlinuz-7.0.0-mindos-sunrise-v1 root=UUID={root_uuid} ro single
    initrd /boot/initramfs-7.0.0-mindos-sunrise-v1.img
}}
"""
            (target_mount / "boot" / "grub").mkdir(parents=True, exist_ok=True)
            with open(target_mount / "boot" / "grub" / "grub.cfg", "w") as f:
                f.write(grub_cfg)

            self.update_progress(0.95, "Sistem temizliği ve disk bağlantıları kapatılıyor...")
            for fs in ["boot/efi", "dev/pts", "dev", "proc", "sys", "run"]:
                subprocess.run(["umount", "-f", f"{target_mount}/{fs}"], check=False)
            subprocess.run(["umount", "-f", str(target_mount)], check=False)

            self.update_progress(1.0, "Kurulum başarıyla tamamlandı!")
            GLib.idle_add(self.stack.set_visible_child_name, "finished")

        except Exception as e:
            GLib.idle_add(self.show_error, f"Kurulum sırasında bir hata oluştu:\n{e}")
            GLib.idle_add(self.stack.set_visible_child_name, "summary")
            GLib.idle_add(self.btn_next.set_sensitive, True)
            GLib.idle_add(self.btn_back.set_sensitive, True)

    def update_progress(self, frac, text):
        GLib.idle_add(self.progress_bar.set_fraction, frac)
        GLib.idle_add(self.lbl_status.set_text, text)


def main():
    app = MindOSInstallerApp()
    return app.run(sys.argv)

if __name__ == "__main__":
    sys.exit(main())

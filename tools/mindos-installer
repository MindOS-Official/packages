    # --------------------------------------------------------------------------
    # Navigation
    # --------------------------------------------------------------------------
    def on_back_clicked(self, btn):
        curr = self.stack.get_visible_child_name()
        order = ["lang", "keyboard", "software", "disk", "timezone", "user", "summary", "installing", "finished"]
        idx = order.index(curr)
        if idx > 0:
            self.stack.set_visible_child_name(order[idx - 1])
            self.btn_back.set_sensitive(idx - 1 > 0)
            self.btn_next.set_label("İleri")

    def on_next_clicked(self, btn):
        curr = self.stack.get_visible_child_name()
        order = ["lang", "keyboard", "software", "disk", "timezone", "user", "summary", "installing", "finished"]
        idx = order.index(curr)

        if curr == "lang":
            self.stack.set_visible_child_name("keyboard")
            self.btn_back.set_sensitive(True)

        elif curr == "keyboard":
            self.stack.set_visible_child_name("software")

        elif curr == "software":
            self.install_profile = "standard" if self.radio_std.get_active() else "minimal"
            self.install_drivers = self.switch_drivers.get_active()
            self.install_codecs = self.switch_codecs.get_active()
            self.stack.set_visible_child_name("disk")

        elif curr == "disk":
            self.stack.set_visible_child_name("timezone")

        elif curr == "timezone":
            tz_map = {0: "Europe/Istanbul", 1: "Asia/Baku", 2: "Asia/Nicosia", 3: "Europe/London", 4: "Europe/Berlin", 5: "Europe/Paris", 6: "America/New_York", 7: "UTC"}
            self.selected_timezone = tz_map.get(self.tz_combo.get_selected(), "Europe/Istanbul")
            self.stack.set_visible_child_name("user")

        elif curr == "user":
            p1 = self.entry_pass.get_text()
            p2 = self.entry_pass_confirm.get_text()
            if p1 != p2:
                self.show_error("Girdiğiniz parolalar birbiriyle eşleşmiyor!")
                return
            self.username = self.entry_user.get_text().strip() or "mindos"
            self.hostname = self.entry_host.get_text().strip() or "mindos-laptop"
            self.password = p1
            self.auto_login = self.switch_autologin.get_active()

            # Update Summary Page
            if self.install_mode == "alongside":
                self.sum_mode.set_subtitle("Windows Boot Manager'ın Yanına Kurulum (Dual Boot)")
                self.sum_disk.set_subtitle(f"Windows: {self.win_gb:.1f} GB  |  MindOS Sunrise: {self.mindos_gb:.1f} GB")
            elif self.install_mode == "erase_disk":
                self.sum_mode.set_subtitle("Tüm Diski Sil ve Sıfırdan Kur")
                self.sum_disk.set_subtitle(f"Tüm {self.selected_disk} diski MindOS için kullanılacak")
            else:
                self.sum_mode.set_subtitle("Elle Bölümlendirme (Manuel)")
                self.sum_disk.set_subtitle("Kullanıcı tarafından GParted ile belirlenen bölümler")

            prof_text = "Standart Kurulum" if self.install_profile == "standard" else "Minimal Kurulum"
            if self.install_drivers: prof_text += " + Donanım Sürücüleri"
            if self.install_codecs: prof_text += " + Medya Kodekleri"
            self.sum_prof.set_subtitle(prof_text)

            self.sum_user.set_subtitle(f"{self.username} ({self.hostname}) - Saat Dilimi: {self.selected_timezone}")
            self.btn_next.set_label("Şimdi Kur")
            self.stack.set_visible_child_name("summary")

        elif curr == "summary":
            self.btn_back.set_sensitive(False)
            self.btn_next.set_sensitive(False)
            self.action_bar.set_visible(False)
            self.header_bar.set_show_title_buttons(False)
            self.stack.set_visible_child_name("installing")
            threading.Thread(target=self.run_installation, daemon=True).start()
            threading.Thread(target=self.run_slideshow, daemon=True).start()


    def scan_disks_and_os(self):
        try:
            out = subprocess.check_output(["lsblk", "-d", "-p", "-n", "-l", "-o", "NAME,SIZE,MODEL,TYPE"], text=True)
            self.disks_data = []
            for line in out.strip().splitlines():
                if "disk" in line and not any(skip in line for skip in ["loop", "zram", "ram"]):
                    parts = line.split()
                    dev = parts[0]
                    size = parts[1] if len(parts) > 1 else ""
                    model = " ".join(parts[2:-1]) if len(parts) > 3 else "Depolama Sürücüsü"
                    display_name = f"{model} ({size}) - {dev}"
                    self.disks_data.append({"dev": dev, "size": size, "model": model, "display": display_name})

            if self.disks_data:
                self.selected_disk = self.disks_data[0]["dev"]

            parts_out = subprocess.check_output(["lsblk", "-p", "-n", "-l", "-o", "NAME,SIZE,FSTYPE,LABEL", self.selected_disk], text=True)
            for line in parts_out.splitlines():
                p_parts = line.split()
                if len(p_parts) >= 3:
                    p_dev = p_parts[0]
                    p_size = p_parts[1]
                    p_fs = p_parts[2].lower()
                    if "vfat" in p_fs or "fat" in p_fs:
                        self.esp_part = p_dev
                    elif "ntfs" in p_fs:
                        self.windows_part = p_dev
                        try:
                            clean_size = p_size.replace("G", "").replace("M", "").replace(",", ".")
                            gb = float(clean_size) / 1024 if "M" in p_size else float(clean_size)
                            if gb > 30:
                                self.total_win_gb = round(gb, 1)
                                self.win_gb = round(self.total_win_gb / 2.0, 1)
                                self.mindos_gb = round(self.total_win_gb - self.win_gb, 1)
                        except Exception:
                            pass
        except Exception as e:
            print("Scan error:", e)


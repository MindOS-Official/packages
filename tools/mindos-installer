#!/usr/bin/env bash
# ==============================================================================
# MindOS Sunrise v1.0 Official System Installer
# ==============================================================================
set -e

if [ "$EUID" -ne 0 ]; then
    echo -e "\033[1;31mHata:\033[0m MindOS Installer için root yetkisi gereklidir."
    echo -e "Lütfen \033[1msudo mindos-installer\033[0m komutu ile çalıştırın."
    exit 1
fi

clear
echo -e "\033[1;33m"
echo "  __  __ _           _  ___  ____    ____                  _          "
echo " |  \/  (_)_ __   __| |/ _ \/ ___|  / ___| _   _ _ __  _ __(_)___  ___ "
echo " | |\/| | | '_ \ / _\` | | | \___ \   \___ \| | | | '_ \| '__| / __|/ _ \ "
echo " | |  | | | | | | (_| | |_| |___) |   ___) | |_| | | | | |  | \__ \  __/"
echo " |_|  |_|_|_| |_|\__,_|\___/|____/   |____/ \__,_|_| |_|_|  |_|___/\___|"
echo "                  MindOS Sunrise v1.0 System Installer"
echo -e "\033[0m\n"

# 1. Disk Listesi Al
echo -e "\033[1;36m==>\033[0m Sistemdeki mevcut depolama sürücüleri taranıyor...\n"
lsblk -d -p -n -l -o NAME,SIZE,MODEL,TYPE | grep -E 'disk' | grep -v 'loop' || true
echo ""

DISKS=$(lsblk -d -p -n -l -o NAME,SIZE,MODEL,TYPE | grep -E 'disk' | grep -v 'loop' | awk '{print $1}')

if [ -z "$DISKS" ]; then
    echo -e "\033[1;31mHata:\033[0m Kurulum yapılacak uygun bir disk bulunamadı!"
    exit 1
fi

echo -e "\033[1;32mKurulum yapılacak hedef diski yazın (örn: /dev/sda veya /dev/nvme0n1):\033[0m"
read -r -p "Hedef Disk: " TARGET_DISK

if [ ! -b "$TARGET_DISK" ]; then
    echo -e "\033[1;31mGeçersiz disk:\033[0m $TARGET_DISK bulunamadı!"
    exit 1
fi

echo ""
echo -e "\033[1;31m⚠ DİKKAT:\033[0m \033[1m$TARGET_DISK\033[0m üzerindeki TÜM VERİLER SİLİNECEKTİR!"
echo -e "MindOS Sunrise v1.0 bu diske temiz kurulum olarak yazılacaktır."
read -r -p "Devam etmek istiyor musunuz? (evet / hayir): " CONFIRM

if [ "$CONFIRM" != "evet" ] && [ "$CONFIRM" != "EVET" ] && [ "$CONFIRM" != "y" ] && [ "$CONFIRM" != "yes" ]; then
    echo "Kurulum iptal edildi."
    exit 0
fi

echo ""
echo -e "\033[1;33m[1/6] Disk bölümlendiriliyor (GPT + ESP + Root)...\033[0m"
# Disk temizle ve GPT oluştur
wipefs -a "$TARGET_DISK"
parted -s "$TARGET_DISK" mklabel gpt
parted -s "$TARGET_DISK" mkpart primary 1MiB 2MiB
parted -s "$TARGET_DISK" set 1 bios_grub on
parted -s "$TARGET_DISK" mkpart primary fat32 2MiB 514MiB
parted -s "$TARGET_DISK" set 2 esp on
parted -s "$TARGET_DISK" mkpart primary ext4 514MiB 100%

# Bölüm adlarını belirle (nvme0n1p1 veya sda1)
if [[ "$TARGET_DISK" =~ [0-9]$ ]]; then
    PART_BIOS="${TARGET_DISK}p1"
    PART_ESP="${TARGET_DISK}p2"
    PART_ROOT="${TARGET_DISK}p3"
else
    PART_BIOS="${TARGET_DISK}1"
    PART_ESP="${TARGET_DISK}2"
    PART_ROOT="${TARGET_DISK}3"
fi

# Kernel partition tablosunu yenilesin
partprobe "$TARGET_DISK" || true
sleep 2

echo -e "\033[1;33m[2/6] Dosya sistemleri biçimlendiriliyor...\033[0m"
mkfs.vfat -F32 -n "MINDOS_ESP" "$PART_ESP"
mkfs.ext4 -F -L "MindOS_Sunrise" "$PART_ROOT"

echo -e "\033[1;33m[3/6] Diskler bağlanıyor...\033[0m"
TARGET_MOUNT="/mnt/mindos_target"
mkdir -p "$TARGET_MOUNT"
mount "$PART_ROOT" "$TARGET_MOUNT"
mkdir -p "$TARGET_MOUNT/boot/efi"
mount "$PART_ESP" "$TARGET_MOUNT/boot/efi"

echo -e "\033[1;33m[4/6] MindOS Sunrise sistemi diske kopyalanıyor (bu işlem birkaç dakika sürebilir)...\033[0m"
rsync -aHAXx --info=progress2 \
    --exclude='/proc/*' \
    --exclude='/sys/*' \
    --exclude='/dev/*' \
    --exclude='/run/*' \
    --exclude='/tmp/*' \
    --exclude='/mnt/*' \
    --exclude='/media/*' \
    --exclude='/lost+found' \
    / "$TARGET_MOUNT/"

# Sanal dizinleri yeniden oluştur
mkdir -p "$TARGET_MOUNT/proc" "$TARGET_MOUNT/sys" "$TARGET_MOUNT/dev" "$TARGET_MOUNT/run" "$TARGET_MOUNT/tmp" "$TARGET_MOUNT/mnt"
chmod 1777 "$TARGET_MOUNT/tmp"

echo -e "\033[1;33m[5/6] fstab ve sistem yapılandırması ayarlanıyor...\033[0m"
ROOT_UUID=$(blkid -s UUID -o value "$PART_ROOT")
ESP_UUID=$(blkid -s UUID -o value "$PART_ESP")

printf "UUID=%s    /            ext4    defaults,noatime    1 1\nUUID=%s     /boot/efi    vfat    defaults            0 2\n" "$ROOT_UUID" "$ESP_UUID" > "$TARGET_MOUNT/etc/fstab"

echo -e "\033[1;33m[6/6] GRUB Önyükleyici kuruluyor (UEFI + BIOS)...\033[0m"
mount --bind /dev "$TARGET_MOUNT/dev"
mount --bind /dev/pts "$TARGET_MOUNT/dev/pts"
mount --bind /proc "$TARGET_MOUNT/proc"
mount --bind /sys "$TARGET_MOUNT/sys"
mount -t tmpfs tmpfs "$TARGET_MOUNT/run"

chroot "$TARGET_MOUNT" grub-install --target=x86_64-efi --efi-directory=/boot/efi --bootloader-id=MindOS_Sunrise --recheck || true
chroot "$TARGET_MOUNT" grub-install --target=i386-pc --recheck "$TARGET_DISK" || true

cat > "$TARGET_MOUNT/boot/grub/grub.cfg" << 'GRUB_CONFIG_EOF'
set default=0
set timeout=5

insmod part_gpt
insmod part_msdos
insmod ext2
insmod fat
insmod all_video

menuentry 'MindOS Sunrise v1.0 (Kernel 7.0)' {
    search --no-floppy --fs-uuid --set=root @ROOT_UUID@
    linux /boot/vmlinuz-7.0.0-mindos-sunrise-v1 root=UUID=@ROOT_UUID@ rw quiet splash init=/lib/systemd/systemd console=tty0
    initrd /boot/initramfs-7.0.0-mindos-sunrise-v1.img
}

menuentry 'MindOS Sunrise v1.0 (Kurtarma / Recovery Modu)' {
    search --no-floppy --fs-uuid --set=root @ROOT_UUID@
    linux /boot/vmlinuz-7.0.0-mindos-sunrise-v1 root=UUID=@ROOT_UUID@ ro single
    initrd /boot/initramfs-7.0.0-mindos-sunrise-v1.img
}
GRUB_CONFIG_EOF

sed -i "s/@ROOT_UUID@/$ROOT_UUID/g" "$TARGET_MOUNT/boot/grub/grub.cfg"

# Temizlik
umount -f "$TARGET_MOUNT/boot/efi" || true
umount -f "$TARGET_MOUNT/dev/pts" || true
umount -f "$TARGET_MOUNT/dev" || true
umount -f "$TARGET_MOUNT/proc" || true
umount -f "$TARGET_MOUNT/sys" || true
umount -f "$TARGET_MOUNT/run" || true
umount -f "$TARGET_MOUNT" || true

echo ""
echo -e "\033[1;32m═══════════════════════════════════════════════════════════════════════════════\033[0m"
echo -e "\033[1;32m🎉 TEBRİKLER! MindOS Sunrise v1.0 başarıyla diske kuruldu!\033[0m"
echo -e "\033[1;32m═══════════════════════════════════════════════════════════════════════════════\033[0m"
echo -e "Artık USB belleğinizi çıkartabilir ve bilgisayarınızı yeniden başlatabilirsiniz:"
echo -e "  \033[1msudo reboot\033[0m\n"

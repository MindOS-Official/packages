    def run_slideshow(self):
        slides = ["slide1", "slide2", "slide3", "slide4"]
        i = 0
        while self.stack.get_visible_child_name() == "installing":
            time.sleep(7)
            i = (i + 1) % len(slides)
            GLib.idle_add(self.slide_stack.set_visible_child_name, slides[i])

    # --------------------------------------------------------------------------
    # Installation Backend Engine
    # --------------------------------------------------------------------------
    def run_installation(self):
        try:
            target_disk = self.selected_disk
            part_esp = self.esp_part
            part_root = ""

            if self.install_mode == "alongside":
                self.update_progress(0.05, f"Windows bölümü ({self.windows_part}) güvenle yeniden boyutlandırılıyor...")
                win_mb = int(self.win_gb * 1024)
                subprocess.run(["ntfsresize", "-P", "-f", "-s", f"{win_mb}M", self.windows_part], check=False)

                part_num = "3"
                if self.windows_part[-1].isdigit():
                    part_num = self.windows_part[-1]

                part_info = subprocess.check_output(["parted", "-m", target_disk, "unit", "MiB", "print"], text=True)
                win_start = "116MiB"
                for pline in part_info.splitlines():
                    if pline.startswith(f"{part_num}:"):
                        win_start = pline.split(":")[1]
                        break

                win_start_val = float(win_start.replace("MiB", ""))
                win_new_end = f"{int(win_start_val + win_mb)}MiB"

                subprocess.run(["parted", "-s", target_disk, "resizepart", part_num, win_new_end], check=False)
                time.sleep(1)

                self.update_progress(0.15, "MindOS Sunrise için yeni kök bölüm (Ext4) oluşturuluyor...")
                subprocess.run(["parted", "-s", target_disk, "mkpart", "primary", "ext4", win_new_end, "100%"], check=False)
                subprocess.run(["partprobe", target_disk], check=False)
                time.sleep(2)

                new_parts = subprocess.check_output(["lsblk", "-p", "-n", "-l", "-o", "NAME", target_disk], text=True).splitlines()
                part_root = new_parts[-1]

                self.update_progress(0.20, f"Bölüm biçimlendiriliyor: {part_root} (Ext4)...")
                subprocess.run(["mkfs.ext4", "-F", "-L", "MindOS_Sunrise", part_root], check=True)

            elif self.install_mode == "erase_disk":
                self.update_progress(0.05, f"Tüm disk temizleniyor ({target_disk})...")
                subprocess.run(["wipefs", "-a", target_disk], check=True)
                subprocess.run(["parted", "-s", target_disk, "mklabel", "gpt"], check=True)
                subprocess.run(["parted", "-s", target_disk, "mkpart", "primary", "1MiB", "2MiB"], check=True)
                subprocess.run(["parted", "-s", target_disk, "set", "1", "bios_grub", "on"], check=True)
                subprocess.run(["parted", "-s", target_disk, "mkpart", "primary", "fat32", "2MiB", "514MiB"], check=True)
                subprocess.run(["parted", "-s", target_disk, "set", "2", "esp", "on"], check=True)
                subprocess.run(["parted", "-s", target_disk, "mkpart", "primary", "ext4", "514MiB", "100%"], check=True)

                if target_disk[-1].isdigit():
                    part_esp = f"{target_disk}p2"
                    part_root = f"{target_disk}p3"
                else:
                    part_esp = f"{target_disk}2"
                    part_root = f"{target_disk}3"

                subprocess.run(["partprobe", target_disk], check=False)
                time.sleep(2)
                subprocess.run(["mkfs.vfat", "-F32", "-n", "MINDOS_ESP", part_esp], check=True)
                subprocess.run(["mkfs.ext4", "-F", "-L", "MindOS_Sunrise", part_root], check=True)

            self.update_progress(0.25, "Diskler bağlanıyor...")
            target_mount = Path("/mnt/mindos_target")
            target_mount.mkdir(parents=True, exist_ok=True)
            subprocess.run(["mount", part_root, str(target_mount)], check=True)
            (target_mount / "boot" / "efi").mkdir(parents=True, exist_ok=True)
            if part_esp:
                subprocess.run(["mount", part_esp, str(target_mount / "boot" / "efi")], check=False)

            self.update_progress(0.35, "MindOS Sunrise diske kopyalanıyor...")
            rsync_cmd = [
                "rsync", "-aHAXx",
                "--exclude=/proc/*",
                "--exclude=/sys/*",
                "--exclude=/dev/*",
                "--exclude=/run/*",
                "--exclude=/tmp/*",
                "--exclude=/mnt/*",
                "--exclude=/media/*",
                "--exclude=/lost+found",
                "/", f"{target_mount}/"
            ]
            subprocess.run(rsync_cmd, check=True)

            self.update_progress(0.75, "Kullanıcı, klavye ve saat dilimi yapılandırılıyor...")
            for d in ["proc", "sys", "dev", "run", "tmp", "mnt"]:
                (target_mount / d).mkdir(parents=True, exist_ok=True)
            os.chmod(target_mount / "tmp", 0o1777)

            root_uuid = subprocess.check_output(["blkid", "-s", "UUID", "-o", "value", part_root], text=True).strip()
            esp_uuid = subprocess.check_output(["blkid", "-s", "UUID", "-o", "value", part_esp], text=True).strip() if part_esp else ""

            fstab_content = f"UUID={root_uuid}    /            ext4    defaults,noatime    1 1\n"
            if esp_uuid:
                fstab_content += f"UUID={esp_uuid}     /boot/efi    vfat    defaults            0 2\n"
            with open(target_mount / "etc" / "fstab", "w") as f:
                f.write(fstab_content)

            with open(target_mount / "etc" / "hostname", "w") as f:
                f.write(f"{self.hostname}\n")

            # Timezone
            tz_file = Path(f"/usr/share/zoneinfo/{self.selected_timezone}")
            if tz_file.exists():
                subprocess.run(["cp", str(tz_file), str(target_mount / "etc" / "localtime")], check=False)

            # Keyboard layout persistence
            (target_mount / "etc" / "vconsole.conf").write_text(f"KEYMAP={self.selected_layout}\n")

            # Setup User Password
            subprocess.run(["chroot", str(target_mount), "sh", "-c", f"echo 'root:{self.password}' | chpasswd"], check=False)
            subprocess.run(["chroot", str(target_mount), "sh", "-c", f"echo '{self.username}:{self.password}' | chpasswd"], check=False)

            self.update_progress(0.85, "GRUB2 Dual-Boot Önyükleyici kuruluyor (UEFI + Windows)...")
            for fs in ["dev", "dev/pts", "proc", "sys"]:
                subprocess.run(["mount", "--bind", f"/{fs}", f"{target_mount}/{fs}"], check=False)
            subprocess.run(["mount", "-t", "tmpfs", "tmpfs", f"{target_mount}/run"], check=False)

            if part_esp:
                subprocess.run(["chroot", str(target_mount), "grub-install", "--target=x86_64-efi",
                                "--efi-directory=/boot/efi", "--bootloader-id=MindOS_Sunrise", "--recheck"], check=False)
            subprocess.run(["chroot", str(target_mount), "grub-install", "--target=i386-pc",
                            "--recheck", target_disk], check=False)

            grub_cfg = f"""set default=0
set timeout=5

insmod part_gpt
insmod part_msdos
insmod ext2
insmod fat
insmod all_video

menuentry 'MindOS Sunrise v1.0 (Kernel 7.0)' {{
    search --no-floppy --fs-uuid --set=root {root_uuid}
    linux /boot/vmlinuz-7.0.0-mindos-sunrise-v1 root=UUID={root_uuid} rw quiet splash init=/lib/systemd/systemd console=tty0
    initrd /boot/initramfs-7.0.0-mindos-sunrise-v1.img
}}

menuentry 'Windows Boot Manager' {{
    insmod fat
    search --no-floppy --fs-uuid --set=root {esp_uuid}
    chainloader /EFI/Microsoft/Boot/bootmgfw.efi
}}

menuentry 'MindOS Sunrise (Kurtarma / Recovery Modu)' {{
    search --no-floppy --fs-uuid --set=root {root_uuid}
    linux /boot/vmlinuz-7.0.0-mindos-sunrise-v1 root=UUID={root_uuid} ro single
    initrd /boot/initramfs-7.0.0-mindos-sunrise-v1.img
}}
"""
            (target_mount / "boot" / "grub").mkdir(parents=True, exist_ok=True)
            with open(target_mount / "boot" / "grub" / "grub.cfg", "w") as f:
                f.write(grub_cfg)

            self.update_progress(0.95, "Sistem temizliği yapılıyor ve diskler kapatılıyor...")
            for fs in ["boot/efi", "dev/pts", "dev", "proc", "sys", "run"]:
                subprocess.run(["umount", "-f", f"{target_mount}/{fs}"], check=False)
            subprocess.run(["umount", "-f", str(target_mount)], check=False)

            self.update_progress(1.0, "Kurulum başarıyla tamamlandı!")
            GLib.idle_add(self.stack.set_visible_child_name, "finished")

        except Exception as e:
            GLib.idle_add(self.show_error, f"Kurulum sırasında bir hata oluştu:\n{e}")
            GLib.idle_add(self.stack.set_visible_child_name, "summary")
            GLib.idle_add(self.btn_next.set_sensitive, True)
            GLib.idle_add(self.btn_back.set_sensitive, True)

    def update_progress(self, frac, text):
        GLib.idle_add(self.progress_bar.set_fraction, frac)
        GLib.idle_add(self.lbl_status.set_text, text)


def main():
    app = MindOSInstallerApp()
    return app.run(sys.argv)


    def on_keyboard_selected(self, combo, param):
        idx = combo.get_selected()
        layout_map = {0: "tr", 1: "tr", 2: "us", 3: "gb", 4: "de", 5: "fr"}
        variant_map = {0: "", 1: "f", 2: "", 3: "", 4: "", 5: ""}
        layout = layout_map.get(idx, "tr")
        variant = variant_map.get(idx, "")
        self.selected_layout = layout

        # Apply layout dynamically to X11/Wayland session
        try:
            if variant:
                subprocess.Popen(["setxkbmap", "-layout", layout, "-variant", variant])
            else:
                subprocess.Popen(["setxkbmap", "-layout", layout])
        except Exception:
            pass

